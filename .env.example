# ============================================================
# create-project 环境变量配置
# 复制此文件为 .env 并填入你的值
#   cp .env.example .env
# ============================================================

# 默认工作目录（新项目将在此目录下创建）
CREATE_PROJECT_WORKSPACE=~/projects

# Cloudflare 配置（可选，脚本会自动从 wrangler 检测）
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_API_TOKEN=your_api_token_here

# GitHub 组织名（可选，不设置则使用个人账户）
# GITHUB_ORG=your_org_name
